#!/usr/bin/env bash

# =========================================================
# 平台判定
# 脚本内所有平台分支都读这个变量，不要各自去调 uname。
# 已设置则尊重外部值——测试靠这个在 Linux 上验证 macOS 分支。
if [ -z "${DOTFILES_OS:-}" ]; then
  case "$(uname -s)" in
    Darwin) DOTFILES_OS=mac ;;
    Linux)  DOTFILES_OS=linux ;;
    *)      DOTFILES_OS=unknown ;;
  esac
fi
export DOTFILES_OS

# =========================================================
# 跨平台

alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias books="cd ~/Books/books"

# 公网出口 IP。macOS 上 `ip` 命令不存在，可以安全占用；Linux 上 `ip` 是系统命令，
# 占用它会毁掉 `ip addr` / `ip route`，所以只在 mac 分支里定义 `ip`。
alias myip="dig +short myip.opendns.com @resolver1.opendns.com"

# `ls` 增强：eza 或 exa，装上哪个用哪个。
#
# eza 是 exa 的活跃分支（exa 上游 2021 年后归档），命令行与 exa 兼容，所以下面这族
# 别名两个都能挂。24.04 起 Ubuntu 源里只剩 eza，22.04 只有 exa —— 两个都认，优先 eza。
if command -v eza &>/dev/null; then
    _ls_bin=eza
elif command -v exa &>/dev/null; then
    _ls_bin=exa
fi

if [ -n "${_ls_bin:-}" ]; then
    # `--git` 必须问二进制自己，不能照着「上游默认开着」写死。Ubuntu 的 exa 是关掉
    # git feature 编的（`--no-default-features`），传 --git 不是「不显示 git 状态」，
    # 而是整个命令以 rc=3 失败：
    #   exa: Options --git and --git-ignore can't be used because `git` feature
    #   was disabled in this build of exa
    # 一个选项就能让 ls / la / ll 全废，而这个 exa 又确实是 apt 正常装上的（见
    # ubuntu.sh 的可选包）。brew 装的 exa 和 Ubuntu 的 eza 都支持，探测一次即可。
    _ls_cols="--icons"
    if "$_ls_bin" --git -d . >/dev/null 2>&1; then
        _ls_cols="--icons --git"
    fi

    alias e="$_ls_bin $_ls_cols"
    alias ea="$_ls_bin -a $_ls_cols"
    alias ee="$_ls_bin -aahl $_ls_cols"
    alias et="$_ls_bin -T -L 3 -a -I \"node_modules|.git|.cache\" --icons"
    alias eta="$_ls_bin -T -a -I \"node_modules|.git|.cache\" --color=always --icons | less -r"

    alias l=e

    alias ls=e
    alias la=ea

    alias ll=ee
    alias lt=et
    alias lta=eta
fi
unset _ls_bin _ls_cols

# Vibe coding
# 启动一个不再问我权限的 Claude Code，同时把自动压缩点提前到 400k
alias c='CLAUDE_CODE_AUTO_COMPACT_WINDOW=400000 claude --dangerously-skip-permissions'
# 长上下文窗口
alias cxl='codex --profile long-context'
# 无审批、无沙箱：仅隔离环境
alias cxy='codex --profile yolo'

alias vpn='ssh vpn'

# Normalize `open` across Linux, macOS, and Windows.
if [ "$DOTFILES_OS" = mac ]; then
    : # macOS 自带 open
elif [ "$DOTFILES_OS" = linux ]; then
    if [ -r /proc/version ] && grep -q Microsoft /proc/version; then
        # Ubuntu on Windows using the Linux subsystem
        alias open='explorer.exe'
    else
        alias open='xdg-open'
    fi
fi

# `o` with no arguments opens the current directory, otherwise opens the given location
function o() {
	if [ $# -eq 0 ]; then
		open .;
	else
		open "$@";
	fi;
}

# =========================================================
# macOS 独占
# 这一整块在 Linux 上无意义：osascript / networksetup / defaults / system_profiler
# 都不存在，调用即失败。用 if 包住而不是让它们静默躺着，顺便让测试能验证。
if [ "$DOTFILES_OS" = mac ]; then

    # 占用 `ip`（macOS 无此命令）
    alias ip="dig +short myip.opendns.com @resolver1.opendns.com"

    # 网络工具
    alias localip="ipconfig getifaddr en0"
    alias flush="dscacheutil -flushcache && killall -HUP mDNSResponder"
    alias ifactive="ifconfig | pcregrep -M -o '^[^\t:]+:([^\n]|\n\t)*status: active'"
    alias flushdns='sudo dscacheutil -flushcache; sudo killall -HUP mDNSResponder'

    # 锁屏（等同 Control + Command + Q）
    alias afk='osascript -e "tell application \"System Events\" to keystroke \"q\" using {control down, command down}"'

    # 浅/深色模式切换
    alias darkmode='osascript -e "tell application \"System Events\" to tell appearance preferences to set dark mode to not dark mode"'

    # Wi-Fi 开关（可能需要改接口名 en0 -> en1）
    alias wifi-on='networksetup -setairportpower en0 on'
    alias wifi-off='networksetup -setairportpower en0 off'

    # 显示/隐藏隐藏文件（立即生效）
    alias show-hidden='defaults write com.apple.finder AppleShowAllFiles -bool true && killall Finder'
    alias hide-hidden='defaults write com.apple.finder AppleShowAllFiles -bool false && killall Finder'

    # 快速打开系统偏好设置面板
    alias open-wifi='open /System/Library/PreferencePanes/Network.prefPane'
    alias open-bluetooth='open /System/Library/PreferencePanes/Bluetooth.prefPane'
    alias open-display='open /System/Library/PreferencePanes/Displays.prefPane'
    alias open-battery='open /System/Library/PreferencePanes/EnergySaver.prefPane'

    # 查看当前 macOS 版本和硬件型号
    alias macinfo='system_profiler SPSoftwareDataType SPHardwareDataType'
fi

# =========================================================
# Linux 独占
if [ "$DOTFILES_OS" = linux ]; then

    # 本机内网 IP（macOS 上 en0 的对应物）
    alias localip="hostname -I | awk '{print \$1}'"

    # systemd-resolved 是 Ubuntu 22.04 的默认解析器
    alias flush="resolvectl flush-caches"
    alias flushdns='sudo resolvectl flush-caches'
fi
