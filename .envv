#!/usr/bin/env bash

# =========================================================
# 平台判定
# .envv 先于 .alias 被加载，这里算好，下游直接读。
# 已设置则尊重外部值——测试靠这个在 Linux 上验证 macOS 分支。
if [ -z "${DOTFILES_OS:-}" ]; then
  case "$(uname -s)" in
    Darwin) DOTFILES_OS=mac ;;
    Linux)  DOTFILES_OS=linux ;;
    *)      DOTFILES_OS=unknown ;;
  esac
fi
export DOTFILES_OS

# =========================================================
# 基础环境
if [ -n "$ZSH_VERSION" ]; then
  HISTSIZE=50000
  setopt HIST_IGNORE_ALL_DUPS
  setopt HIST_REDUCE_BLANKS
  setopt SHARE_HISTORY
  setopt EXTENDED_HISTORY
  setopt INTERACTIVE_COMMENTS
  setopt NO_BEEP
fi
if [ -n "$BASH_VERSION" ]; then
  HISTSIZE=50000
  HISTFILESIZE=50000
  shopt -s histappend
  export HISTCONTROL=ignoredups:erasedups
fi
# 语言环境：裸 Ubuntu 未生成 en_US.UTF-8 时，写死它会让每个命令都刷
# "setlocale: LC_ALL: cannot change locale"。探测一次，缺失就退回 C.UTF-8。
# 父进程通常已导出 LANG/LC_ALL，所以这个探测只在首次进入时付出一次 fork 成本。
if [ -z "${LANG:-}" ] || [ -z "${LC_ALL:-}" ]; then
  if locale -a 2>/dev/null | grep -qiE '^en_US\.utf-?8$'; then
    export LANG=en_US.UTF-8
    export LC_ALL=en_US.UTF-8
  else
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
  fi
fi

# 编辑器：没装 Emacs 时 emacsclient 会让 `git commit`、`crontab -e` 直接失败。
if command -v emacsclient >/dev/null 2>&1; then
  export EDITOR='emacsclient -t'
  export VISUAL='emacsclient -c -a emacs'
elif command -v vim >/dev/null 2>&1; then
  export EDITOR='vim'
  export VISUAL='vim'
else
  export EDITOR='vi'
  export VISUAL='vi'
fi

[ -t 0 ] && export GPG_TTY="$(tty)"

# =========================================================
# API Keys
# vim ~/.config/secrets/env
# export DEEPSEEK_API_KEY='sk-...'
# export OPENROUTER_API_KEY='sk-or-...'
# 权限收紧： chmod 600 ~/.config/secrets/env

[ -r "$HOME/.config/secrets/env" ] && . "$HOME/.config/secrets/env"

# =========================================================
# Homebrew
if command -v brew >/dev/null 2>&1; then
  eval "$(brew shellenv)"
fi

# =========================================================
# 路径去重
_path_prepend() {
  case ":$PATH:" in
    *:"$1":*) ;;
    *) [ -d "$1" ] && export PATH="$1:$PATH" ;;
  esac
}
_path_append() {
  case ":$PATH:" in
    *:"$1":*) ;;
    *) [ -d "$1" ] && export PATH="$PATH:$1" ;;
  esac
}

# =========================================================
# 用户目录
_path_prepend "$HOME/bin"
_path_prepend "$HOME/.local/bin"
_path_prepend "$HOME/.local/share/bin"

# =========================================================
# XDG 基础目录
[ -z "$XDG_CONFIG_HOME" ] && export XDG_CONFIG_HOME="$HOME/.config"
[ -z "$XDG_DATA_HOME"   ] && export XDG_DATA_HOME="$HOME/.local/share"
[ -z "$XDG_CACHE_HOME"  ] && export XDG_CACHE_HOME="$HOME/.cache"
[ -z "$XDG_STATE_HOME"  ] && export XDG_STATE_HOME="$HOME/.local/state"

# =========================================================
# asdf version manager（必须排在 conda 之前，见 .zshrc 末尾那段）
#
# 闸门是 shims 目录，不是 `command -v asdf`：后者把「asdf 命令在不在 PATH 上」
# 当成了「该不该挂 shims」。二进制还没进 PATH 时（比如按官方文档自己装、落在数据
# 目录里的那种布局），命令还找不到，整段就被跳过，它名下的语言跟着一起消失。
# 该不该动 PATH 只取决于 shims 目录在不在。
#
# 二进制本身不在这里找：Linux 上 ubuntu.sh 把它装进 ~/.local/bin（上面已挂进
# PATH），macOS 上 brew.sh 装进 brew 的 bin。
export ASDF_DATA_DIR="${ASDF_DATA_DIR:-$HOME/.asdf}"
if [ -d "$ASDF_DATA_DIR/shims" ]; then
  _path_prepend "$ASDF_DATA_DIR/shims"
fi

# =========================================================
# Node.js
_path_prepend "$HOME/.npm-global/bin"

# =========================================================
# Golang
if command -v go >/dev/null 2>&1; then
  export GOPATH="${GOPATH:-$HOME/go}"
  export GOPROXY='https://goproxy.cn,direct'
  _path_prepend "$GOPATH/bin"
  # asdf 装的 Go 要把 GOROOT 指到那个版本目录。取不到就保持原样：写成
  # GOROOT="$(asdf where golang)" 会在 asdf 没有 golang 插件时把已有的
  # （乃至外部导出的）GOROOT 抹成空串，Go 接着报 "cannot find GOROOT"。
  if command -v asdf >/dev/null 2>&1; then
    _goroot="$(asdf where golang 2>/dev/null || true)"
    [ -n "$_goroot" ] && export GOROOT="$_goroot"
  fi
fi

# =========================================================
# Rust
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# =========================================================
# macOS 工具链
if [ "$DOTFILES_OS" = "mac" ] && command -v brew >/dev/null 2>&1; then
  BREW_PREFIX="$(brew --prefix)"
  if [ -d "$BREW_PREFIX/opt/openjdk" ]; then
    export JAVA_HOME="$BREW_PREFIX/opt/openjdk"
    _path_prepend "$JAVA_HOME/bin"
  fi
  if [ -d "$BREW_PREFIX/opt/openssl@3" ]; then
    export LDFLAGS="-L$BREW_PREFIX/opt/openssl@3/lib"
    export CPPFLAGS="-I$BREW_PREFIX/opt/openssl@3/include"
    export PKG_CONFIG_PATH="$BREW_PREFIX/opt/openssl@3/lib/pkgconfig"
  fi
fi

unset _goroot
unset -f _path_prepend _path_append
